# 이 파일을 복사해서 .env 로 만들고 값을 채우세요.
# .env 는 .gitignore 에 등록돼 있어 깃허브에 올라가지 않습니다.

# 필수 — Gemini API 키 (대괄호/따옴표 없이, 39자)
GEMINI_API_KEY=여기에_제미나이_API_키

# 1회 실행당 지점별 최대 답글 수 (테스트할 땐 1로)
MAX_PER_RUN=5

# 창을 숨기고 싶으면 true. 네이버 호환성을 위해 기본은 false 권장
HEADLESS=false

# ── 알림 (솔라피) ──────────────────────────────────────────────
# solapi.com > 개발/연동 > API Key 관리 에서 발급
SOLAPI_API_KEY=
SOLAPI_API_SECRET=
SOLAPI_FROM=01012345678      # 솔라피에 등록된 발신번호
SOLAPI_TO=01012345678        # 알림 받을 번호
# 카카오톡 채널 발신프로필 ID (KA01PF... 형태)
SOLAPI_PFID=
# 메시지 유형 — CTA=친구톡 14원 / LMS=장문문자 29원 / SMS=단문문자 13원
# 비워두면 CTA(친구톡). 지정하지 않으면 브랜드메시지(BMS, 고가)로 나갈 수 있으니 그대로 두세요.
SOLAPI_TYPE=CTA

# ── 알림 (카카오 나에게 보내기) — 솔라피가 없을 때만 사용 ──────
KAKAO_REST_KEY=
KAKAO_REFRESH_TOKEN=

# 네이버 로그인은 chrome-profile 폴더에 저장됩니다.
# 최초 1회 `node login.js` 실행 → 로그인하면 이후 자동 유지됩니다.
# NAVER_NID_AUT / NAVER_NID_SES 는 더 이상 필요 없습니다.

# ── 진짜 크롬에 붙기 (2026-09-07 추가) ─────────────────────────
#
# 네이버가 자동화 브라우저를 알아보고 리뷰만 막습니다.
# 사장님이 평소 쓰는 크롬에 봇이 올라타면 구별할 방법이 없어집니다.
#
# 쓰는 법
#   ① 바탕화면에 바로가기를 하나 만들고, 위치에 아래를 넣습니다
#      "C:\Program Files (x86)\Google\Chrome\Application\chrome.exe" --remote-debugging-port=9222 --user-data-dir="C:\chrome-bot"
#   ② 그 크롬으로 네이버에 로그인해둡니다 (한 번만)
#   ③ 아래 줄의 주석(#)을 풀어 .env 에 넣습니다
#   ④ 봇이 도는 시각(9시·18시)에 그 크롬이 켜져 있어야 합니다
#
# ⚠️ 비워두면 예전처럼 봇 전용 프로필로 크롬을 새로 띄웁니다 (네이버에 막힐 수 있음)
# ⚠️ 못 붙으면 자동으로 예전 방식으로 넘어갑니다. 갑자기 멈추지는 않습니다
# CHROME_DEBUG_PORT=9222
