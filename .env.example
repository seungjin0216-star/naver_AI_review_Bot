# 이 파일을 복사해서 .env 로 만들고 값을 채우세요.
# .env 는 .gitignore 에 등록돼 있어 깃허브에 올라가지 않습니다.

# 필수 — Gemini API 키 (대괄호/따옴표 없이, 39자)
GEMINI_API_KEY=여기에_제미나이_API_키

# 1회 실행당 지점별 최대 답글 수 (테스트할 땐 1로)
MAX_PER_RUN=5

# 창을 숨기고 싶으면 true. 네이버 호환성을 위해 기본은 false 권장
HEADLESS=false

# 카카오톡 알림 — `node kakao-setup.js` 실행하면 자동으로 채워집니다
KAKAO_REST_KEY=
KAKAO_REFRESH_TOKEN=

# 네이버 로그인은 chrome-profile 폴더에 저장됩니다.
# 최초 1회 `node login.js` 실행 → 로그인하면 이후 자동 유지됩니다.
# NAVER_NID_AUT / NAVER_NID_SES 는 더 이상 필요 없습니다.
